# Kopieren nach deploy/.env und Werte anpassen. .env NICHT committen
# (siehe .gitignore) — enthält Postgres- und Organisator:innen-Passwort.

POSTGRES_DB=zwt_probeplan
POSTGRES_USER=zwt
POSTGRES_PASSWORD=bitte-ein-sicheres-passwort-eintragen

# Phase 7: gemeinsames Passwort für Organisator:innen (schützt nur
# Schreiboperationen — Termine anlegen/ändern/löschen, Stand sperren;
# Lesen/Ansehen bleibt für alle offen, siehe REFERENCE.md/PROGRESS.md
# "Zugriffsmodell"). ORGANISATOR_BENUTZER ist optional, Standard
# "organisator".
ORGANISATOR_BENUTZER=organisator
ORGANISATOR_PASSWORT=bitte-ein-sicheres-passwort-eintragen
