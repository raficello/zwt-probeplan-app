# ZwT Probeplan — Caddy-Reverse-Proxy-Konfiguration.
#
# Domain ist seit 07.09.2026 bekannt (Rafi-Feedback): schedule.zwischentoene.com
# zeigt bereits auf diesen VPS. Caddy übernimmt automatisch ein
# Let's-Encrypt-Zertifikat für diese Domain, sobald der Container mit
# dieser Datei läuft und Port 80+443 von aussen erreichbar sind (siehe
# deploy/README.md Schritt 8, Firewall) — keine weitere Konfiguration
# nötig.

schedule.zwischentoene.com {
	reverse_proxy app:3000
	encode gzip
}

# --- Übergangs-Variante: nackte IP, falls die Domain mal nicht
# auflöst oder zu Testzwecken parallel gebraucht wird. Kein
# automatisches HTTPS über die nackte IP (Let's Encrypt braucht einen
# Hostnamen) -- bei Bedarf einkommentieren. Normalerweise NICHT nötig,
# seit die Domain steht.
# :80 {
# 	reverse_proxy app:3000
# 	encode gzip
# }
